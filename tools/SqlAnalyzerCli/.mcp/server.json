{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "description": "Analyze T-SQL scripts for design, naming, and performance issues and prevent bad practices.",
  "name": "io.github.ErikEJ/SqlServer.Rules",
  "version": "1.0",
  "packages": [
    {
      "registryType": "nuget",
      "identifier": "ErikEJ.DacFX.TSQLAnalyzer.Cli",
      "version": "1.0.64",
      "registryBaseUrl": "https://api.nuget.org/v3/index.json",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "-mcp"
        }
      ],
      "environmentVariables": []
    }
  ],
  "repository": {
    "url": "https://github.com/ErikEJ/SqlServer.Rules",
    "source": "github"
  }
}
